{
  "name": "idisu",
  "displayName": "Īdisu (エディス · Learning Platform)",
  "version": "0.2.0",
  "description": "Furaidē's dreaming eye — watches how you work across harnesses and surfaces skill usage, gaps, and improvement suggestions. Run packages/cli/src/targets/claude-code/install.sh to install.",
  "author": {
    "name": "pratty010",
    "url": "https://github.com/pratty010/Furaide"
  },
  "hooks": {
    "SessionStart":      ["hooks/session_start.sh"],
    "PreToolUse":        [{ "matcher": "Skill", "hooks": ["hooks/skill_pre.sh"] }],
    "PostToolUse":       [{ "matcher": "Skill", "hooks": ["hooks/skill_post.sh"] }],
    "PostToolUseFailure":[{ "matcher": "Skill", "hooks": ["hooks/skill_post_failure.sh"] }],
    "UserPromptExpansion":["hooks/user_prompt_expansion.sh"],
    "Stop":              ["hooks/stop.sh"],
    "StopFailure":       ["hooks/stop.sh"]
  }
}
