#!/usr/bin/env bash
# Legacy Mekiki PATH shim — forwards to the bootstrapped Satori CLI.
set -euo pipefail
if command -v mekiki >/dev/null 2>&1 && [[ "$(command -v mekiki)" != "${BASH_SOURCE[0]}" ]]; then
  exec "$(command -v mekiki)" "$@"
fi
SATORI_HOME="${SATORI_HOME:-$HOME/.satori}"
STATE="$SATORI_HOME/cli-path"
if [[ -f "$STATE" ]]; then
  CLI_BIN="$(cat "$STATE")"
  [[ -x "$CLI_BIN" ]] && exec "$CLI_BIN" "$@"
fi
echo "mekiki CLI not installed. Run: bash <repo>/harnesses/claude-code/scripts/bootstrap.sh" >&2
exit 127
