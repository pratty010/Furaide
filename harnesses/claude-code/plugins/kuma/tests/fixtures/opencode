#!/usr/bin/env node
const args = process.argv.slice(2);
if (args[0] === "models") {
  process.stdout.write("opencode-go/deepseek-v4-pro\nopencode/big-pickle\nanthropic/claude\n");
  process.exit(0);
}
if (args[0] === "run") {
  // Check for test mode: exit with error if OPENCODE_FIXTURE_FAIL is set
  if (process.env.OPENCODE_FIXTURE_FAIL) {
    process.stderr.write("Backend error: simulated failure");
    process.exit(1);
  }
  process.stdout.write(JSON.stringify({ verdict: "approve", summary: "ok", findings: [], next_steps: [] }));
  process.exit(0);
}
if (args[0] === "providers") {
  process.stdout.write("opencode-go\nopencode\n");
  process.exit(0);
}
process.exit(1);
