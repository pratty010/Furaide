#!/usr/bin/env node
const fs = require("node:fs")

const args = process.argv.slice(2);

if (process.env.OPENCODE_CAPTURE_ARGS_FILE) {
  fs.writeFileSync(process.env.OPENCODE_CAPTURE_ARGS_FILE, JSON.stringify(args), "utf8")
}

if (process.env.OPENCODE_CAPTURE_PROMPT_FILE && args[0] === "run") {
  fs.writeFileSync(process.env.OPENCODE_CAPTURE_PROMPT_FILE, args.at(-1) ?? "", "utf8")
}

if (args[0] === "models") {
  process.stdout.write("opencode-go/deepseek-v4-pro\nopencode/big-pickle\nanthropic/claude\n");
  process.exit(0);
}
if (args[0] === "run") {
  if (process.env.OPENCODE_FIXTURE_SLEEP_MS) {
    process.on("SIGTERM", () => process.exit(0))
    setTimeout(() => {
      process.stdout.write(JSON.stringify({ verdict: "approve", summary: "ok", findings: [], next_steps: [] }))
      process.exit(0)
    }, Number(process.env.OPENCODE_FIXTURE_SLEEP_MS))
  } else if (process.env.OPENCODE_FIXTURE_OUTPUT_SIZE) {
    process.stdout.write("x".repeat(Number(process.env.OPENCODE_FIXTURE_OUTPUT_SIZE)))
    process.exit(0)
  } else if (process.env.OPENCODE_FIXTURE_FAIL) {
    process.stderr.write("Backend error: simulated failure");
    process.exit(1);
  } else if (process.env.OPENCODE_FIXTURE_JSON_LINES) {
    const review = {
      verdict: "approve",
      summary: "json-lines review",
      findings: [],
      next_steps: [],
    }
    process.stdout.write(
      `${JSON.stringify({ type: "message", text: "working" })}\n${JSON.stringify({ type: "final", payload: review })}\n`
    )
    process.exit(0)
  } else {
    process.stdout.write(JSON.stringify({ verdict: "approve", summary: "ok", findings: [], next_steps: [] }));
    process.exit(0);
  }
}
if (args[0] === "providers") {
  process.stdout.write("opencode-go\nopencode\n");
  process.exit(0);
}
process.exit(1);
