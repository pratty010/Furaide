{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "lsp": true,
  "plugin": [
    "./plugins/nio.js",
    "./plugins/nurikabe.js",
    "./plugins/komainu.js",
    "./plugins/migawari.js",
    "./plugins/web-tools.ts"
  ],
  "instructions": [
    "./rules/*.md"
  ],
  "agent": {
    "tsuchigumo--research-weaver": { "model": "opencode-go/kimi-k2.6" },
    "daikoku--finance-steward": { "model": "opencode-go/qwen3.7-max" },
    "enma--compliance-judge": { "model": "opencode-go/qwen3.6-plus" },
    "fudo--security-guardian": { "model": "opencode-go/kimi-k2.6" },
    "tsukumogami--code-forgemaster": { "model": "opencode-go/kimi-k2.6" },
    "daidarabotchi--infra-shaper": { "model": "opencode-go/kimi-k2.6" },
    "tsukuyomi--spec-oracle": { "model": "opencode-go/qwen3.6-plus" },
    "yumemi--story-smith": { "model": "opencode-go/glm-5.1" },
    "mujina--brand-shapeshifter": { "model": "openai/gpt-5.4" },
    "sojobo--system-strategist": { "model": "opencode-go/kimi-k2.6" },
    "shiranui--migration-guide": { "model": "opencode-go/kimi-k2.6" },
    "chizu--implementation-planner": { "model": "opencode-go/kimi-k2.6" },
    "yamabiko--source-echo": { "model": "opencode-go/minimax-m2.7" },
    "kagami--truth-mirror": { "model": "openai/gpt-5.4-mini" },
    "soroban--number-sage": { "model": "opencode-go/deepseek-v4-flash" },
    "karakuri--command-runner": { "model": "opencode-go/mimo-v2.5" },
    "mikoshi--code-pathfinder": { "model": "opencode-go/qwen3.6-plus" },
    "oni--red-team-reviewer": { "model": "openai/gpt-5.5" },
    "kotodama--prose-polisher": { "model": "google-vertex/gemini-3.1-pro-preview" },
    "jorogumo--synthesis-weaver": { "model": "opencode-go/glm-5.2" },
    "tengu--visual-artisan": { "model": "google-vertex/gemini-3.5-flash" },
    "bakeneko--bug-hunter": { "model": "opencode-go/deepseek-v4-pro" },
    "makimono--docs-scribe": { "model": "opencode-go/glm-5.2" },
    "azukiarai--data-sifter": { "model": "opencode-go/minimax-m2.7" },
    "henge--format-shifter": { "model": "opencode-go/mimo-v2.5" },
    "tanuki--general-trickster": { "model": "opencode/big-pickle" },
    "karasutengu--docs-scout": { "model": "opencode/big-pickle" },
    "hanko--git-seal": { "model": "openai/gpt-5.4-mini" },
    "mizuchi--data-current": { "model": "opencode-go/deepseek-v4-flash" },
    "tanuki--codemod-runner": { "model": "opencode-go/mimo-v2.5" },
    "general": {
      "model": "opencode-go/mimo-v2.5",
      "prompt": "You execute exactly what you are given and return results faithfully: stdout, stderr, exit code, extracted fields, or formatted output. You do not interpret, synthesize, infer missing values, or make judgment calls. If the brief is ambiguous or the task requires judgment, stop and return what you have plus a one-line reason instead of guessing. Never dispatch yourself. Never re-dispatch the task you were given.",
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "explore": {
      "prompt": "You are the local recon subagent. Return a compact findings table (Area | Files | Existing Pattern | Why Relevant). Cite exact paths and line ranges. Do not propose fixes, do not synthesize conclusions, do not edit. Never dispatch yourself.",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },
    "scout": {
      "prompt": "You are the external recon subagent. Your role is to retrieve and organize information from external sources (documentation, package registries, GitHub) to support implementation decisions. Return a compact findings table: (Source | Tool | Version/Date | Finding | Relevance). Include a prior-art / build-vs-buy output block for any new implementation: Existing option found: yes/no, Candidate, Fit, Gaps, Recommendation. Cite exact sources and versions. Use ctx7 for versioned library/API docs and gh for upstream repository recon. Do not propose fixes, do not synthesize conclusions, do not edit. Never dispatch yourself.",
      "permission": {
        "edit": "deny",
        "task": "deny",
        "bash": {
          "ctx7 *": "allow",
          "gh *": "allow",
          "*": "deny"
        }
      }
    }
  }
}
